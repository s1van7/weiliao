# 微聊 · 后端运行环境变量（部署时按需填写，复制到 systemd 环境或 .env 加载器）

# ---- TURN（coturn static-auth-secret）----
# 未配置 TURN_SECRET 时，/api/rtc-config 只返回 STUN，通话仍可尽力直连。
# 与 coturn 的 static-auth-secret 保持一致；留空则前端只拿 STUN，通话走直连
TURN_SECRET=
# 注意：TURN 的 UDP 不能走 Cloudflare Tunnel，必须直连 VPS 公网 IP（或为其配置 A 记录的独立子域名）
TURN_HOST=203.0.113.10
TURN_PORT=3478

# ---- 语音转文字（whisper.cpp server）----
# 默认本机 127.0.0.1:9000；置空字符串可让转写接口返回 503 ASR_NOT_CONFIGURED。
WHISPER_ENDPOINT=http://127.0.0.1:9000
WHISPER_TIMEOUT_MS=60000

# ---- 分片上传 ----
# 单文件上限（字节），默认 2GB。
UPLOAD_FILE_MAX_BYTES=2147483648
