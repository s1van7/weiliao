[Unit]
Description=WeChat Lite chat service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/wechat-lite
ExecStart=/usr/bin/node server/index.js
Environment=NODE_ENV=production
Environment=PORT=3000
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
